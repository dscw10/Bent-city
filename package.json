{
  "name": "melonpan-delivery-service",
  "private": true,
  "version": "0.8.0",
  "type": "module",
  "description": "An arcade delivery game whose city folds up in front of you: street-level perspective near the truck, top-down map far ahead, in one continuous view.",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "check": "tsc --noEmit && vitest run"
  },
  "dependencies": {
    "three": "^0.185.1"
  },
  "devDependencies": {
    "@types/three": "^0.185.0",
    "typescript": "^5.9.3",
    "vite": "^7.1.12",
    "vitest": "^4.1.11"
  }
}
